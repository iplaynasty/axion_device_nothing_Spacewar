<?xml version="1.0" encoding="utf-8"?>
<!--
  AxPerfConfig UX thread uclamp defaults — Nothing Phone 1 (Spacewar)
  Profile: Balanced Battery + Balanced Performance

  Kernel uclamp scale: 0–1024
    0    = fully unconstrained (scheduler chooses freely)
    1024 = always maximum utilization

  v3 changes (battery++ + QS jitter fix):
  • render:              512 → 384  (A55 OK for light frames, big core preferred)
  • surfaceflinger_main: 192 → 280  [QS fix] SF must be on big core every vsync
  • surfaceflinger_render:256 → 360  [QS fix] GPU dispatch thread, jitter-critical
  • ui thread:            64 → 128  [QS fix] SystemUI tile inflation during open
  • input_dispatcher:    200 → 128  (still snappy)
  • audio:               128 →  64  (event-driven, low load)

  These lower uclamp_min values mean:
  ✓ Threads still scale up to big cores under actual load
  ✓ When load is low they fall back to efficient A55 cores → battery saving
-->
<threads>

    <!--
      Render thread: 384 — allows A55 during light frames but prefers big cores.
    -->
    <role name="render"
          uclamp_min="384"
          uclamp_max="1024" />

    <!--
      SurfaceFlinger main: lifted 192 → 280.
      QS jitter fix: SF main must be scheduled on a big core every vsync during
      QS animation; 192 was too low and allowed the A55 to pick it up.
    -->
    <role name="surfaceflinger_main"
          uclamp_min="280"
          uclamp_max="1024" />

    <!--
      SF render engine: lifted 256 → 360.
      QS jitter fix: this thread does the actual BackgroundBlur GPU dispatch;
      if it slips off the big core even briefly, blur rendering spills a frame.
    -->
    <role name="surfaceflinger_render"
          uclamp_min="360"
          uclamp_max="1024" />

    <!--
      App UI thread: lifted 64 → 128.
      QS jitter fix: SystemUI's main thread inflates QS tiles during the open
      animation; at uclamp_min=64 it could land on A55 mid-animation.
    -->
    <role name="ui"
          uclamp_min="128"
          uclamp_max="1024" />

    <!-- Input dispatcher: keeps touch snappy; 128 is enough to stay on big cores -->
    <role name="input_dispatcher"
          uclamp_min="128"
          uclamp_max="1024" />

    <!-- Input reader: purely interrupt-driven, very low load -->
    <role name="input_reader"
          uclamp_min="64"
          uclamp_max="1024" />

    <!-- System server: reduced — it handles many background tasks on A55 fine -->
    <role name="system_server_main"
          uclamp_min="32"
          uclamp_max="1024" />

    <!-- Binder: IPC threads, usually short bursts; A55 handles well -->
    <role name="binder"
          uclamp_min="0"
          uclamp_max="384" />

    <!-- Audio: event-driven, low sustained CPU; 64 prevents unnecessary big-core use -->
    <role name="audio"
          uclamp_min="64"
          uclamp_max="512" />

    <!-- Background / dexopt: keep well away from big cores -->
    <role name="background"
          uclamp_min="0"
          uclamp_max="384" />

</threads>
