<?xml version="1.0" encoding="utf-8"?>
<!--
  AxPerfConfig UX thread uclamp defaults — Nothing Phone 1 (Spacewar)
  Profile: Balanced Battery + Balanced Performance

  Kernel uclamp scale: 0–1024
    0    = fully unconstrained (scheduler chooses freely)
    1024 = always maximum utilization

  Balanced strategy vs. max-perf:
  • render:             512 → 384  (scheduler can use big-A55 when headroom exists)
  • surfaceflinger_main: 256 → 192
  • ui thread:          128 →  64  (mostly idle, let A55 handle it)
  • input_dispatcher:   200 → 128  (still snappy, but lighter)
  • audio:              128 →  64  (audio driver is event-driven, not load-heavy)

  These lower uclamp_min values mean:
  ✓ Threads still scale up to big cores under actual load
  ✓ When load is low they fall back to efficient A55 cores → battery saving
-->
<threads>

    <!--
      Render thread: reduced from 512 to 384.
      Still prefers big cores but allows A55 during light frames (menus, etc.).
    -->
    <role name="render"
          uclamp_min="384"
          uclamp_max="1024" />

    <!-- SurfaceFlinger main: slightly reduced, compositor is often idle -->
    <role name="surfaceflinger_main"
          uclamp_min="192"
          uclamp_max="1024" />

    <!-- SF render engine: moderate — GPU composition is bursty, not sustained -->
    <role name="surfaceflinger_render"
          uclamp_min="256"
          uclamp_max="1024" />

    <!-- App UI thread: low default; boost hints handle heavy moments -->
    <role name="ui"
          uclamp_min="64"
          uclamp_max="1024" />

    <!-- Input dispatcher: keeps touch snappy; 128 is enough to stay on big cores -->
    <role name="input_dispatcher"
          uclamp_min="128"
          uclamp_max="1024" />

    <!-- Input reader: purely interrupt-driven, very low load -->
    <role name="input_reader"
          uclamp_min="64"
          uclamp_max="1024" />

    <!-- System server: reduced — it handles many background tasks on A55 fine -->
    <role name="system_server_main"
          uclamp_min="32"
          uclamp_max="1024" />

    <!-- Binder: IPC threads, usually short bursts; A55 handles well -->
    <role name="binder"
          uclamp_min="0"
          uclamp_max="384" />

    <!-- Audio: event-driven, low sustained CPU; 64 prevents unnecessary big-core use -->
    <role name="audio"
          uclamp_min="64"
          uclamp_max="512" />

    <!-- Background / dexopt: keep well away from big cores -->
    <role name="background"
          uclamp_min="0"
          uclamp_max="384" />

</threads>
